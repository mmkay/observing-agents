      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$hermes_service\"}",
          "tableType": "traces",
          "refId": "A"
        }
      ],
      "description": "Hermes emits one span per diagnostic event; in practice only the periodic gateway.health_snapshot heartbeat is observed live, so this is a liveness/browse view of the traces pipeline rather than an operational trace overview (spans are ~microseconds, single-span traces, no meaningful duration signal to chart). Confirms traces are actually reaching Tempo, which is a separate path from metrics and subject to tail-sampling (see docs/setup-hermes.md)."
    }
