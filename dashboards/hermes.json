    {
      "id": 21,
      "type": "table",
      "title": "Recent Gateway Health Traces (from Tempo)",
      "datasource": {
        "type": "datasource",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
