      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (agent) (increase(opencode_token_usage[$__range]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ]
    },
