      "targets": [
        {
          "datasource": {
            "type": "datasource",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(opencode_token_usage{type=\"cacheRead\"}[1h])) / (sum(rate(opencode_token_usage{type=\"cacheRead\"}[1h])) + sum(rate(opencode_token_usage{type=\"input\"}[1h])))",
          "legendFormat": "cache hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Cache Creation vs Cache Reads",
