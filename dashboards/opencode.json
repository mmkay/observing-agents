        "y": 32,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Cache Hit Rate",
      "description": "Ratio of cache-read tokens to total input tokens (cacheRead / (cacheRead + input)). Higher is better.",
      "datasource": {
        "type": "datasource",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
