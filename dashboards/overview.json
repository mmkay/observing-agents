{
  "schemaVersion": 39,
  "uid": "ao-overview",
  "title": "Agent Observability — Overview",
  "tags": ["agents", "overview"],
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "5m",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Loki",
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Tempo",
        "name": "DS_TEMPO",
        "options": [],
        "query": "tempo",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "name": "openclaw_enable",
        "label": "OpenClaw",
        "type": "custom",
        "query": "Include : openclaw-gateway,Exclude : NOOP_NO_MATCH",
        "current": { "value": "openclaw-gateway", "text": "Include" },
        "options": [
          { "selected": true,  "text": "Include", "value": "openclaw-gateway" },
          { "selected": false, "text": "Exclude", "value": "NOOP_NO_MATCH" }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 0
      },
      {
        "name": "copilot_enable",
        "label": "GitHub Copilot",
        "type": "custom",
        "query": "Include : github-copilot,Exclude : NOOP_NO_MATCH",
        "current": { "value": "github-copilot", "text": "Include" },
        "options": [
          { "selected": true,  "text": "Include", "value": "github-copilot" },
          { "selected": false, "text": "Exclude", "value": "NOOP_NO_MATCH" }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 0
      }
    ]
  },
  "timepicker": {},
  "timezone": "browser",
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Today",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Total Sessions (24h)",
      "description": "Sessions across Claude Code + OpenCode + OpenClaw in the last 24 hours",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "timeFrom": "now-24h",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(claude_code_session_count[24h]))",
          "legendFormat": "Claude Code",
          "refId": "A",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(opencode_session_count{is_subagent=\"false\"}[24h]))",
          "legendFormat": "OpenCode",
          "refId": "B",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_run_duration_ms_count{job=~\"$openclaw_enable\"}[24h])) without (openclaw_model, openclaw_provider, openclaw_outcome, openclaw_channel, openclaw_agent)",
          "legendFormat": "OpenClaw",
          "refId": "C",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(github_copilot_agent_turn_count_count{job=~\"$copilot_enable\"}[24h]))",
          "legendFormat": "GitHub Copilot",
          "refId": "D",
          "instant": true
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Total Tokens (24h)",
      "description": "Tokens consumed across all tools in the last 24 hours",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "timeFrom": "now-24h",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000000 },
              { "color": "red", "value": 10000000 }
            ]
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(claude_code_token_usage[24h])) without (session_id, user_email, user_id, user_account_id, user_account_uuid, organization_id, type, effort, query_source, model, terminal_type, agent_name, skill_name)",
          "legendFormat": "Claude Code",
          "refId": "A",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(opencode_token_usage[24h])) without (session_id, project_id, type, agent, model)",
          "legendFormat": "OpenCode",
          "refId": "B",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_tokens{job=~\"$openclaw_enable\"}[24h])) without (openclaw_model, openclaw_provider, openclaw_agent, openclaw_channel, openclaw_token)",
          "legendFormat": "OpenClaw",
          "refId": "C",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(gen_ai_client_token_usage_sum{job=~\"$copilot_enable\"}[24h]))",
          "legendFormat": "GitHub Copilot",
          "refId": "D",
          "instant": true
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Total Cost (24h, USD)",
      "description": "Spend across Claude Code and OpenCode in the last 24 hours. OpenClaw has no cost metric.",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "timeFrom": "now-24h",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 25 }
            ]
          },
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "$0.00"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(claude_code_cost_usage[24h])) without (session_id, user_email, user_id, user_account_id, user_account_uuid, organization_id, model, effort, query_source, terminal_type, agent_name, skill_name)",
          "legendFormat": "Claude Code",
          "refId": "A",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(opencode_cost_usage[24h])) without (session_id, project_id, model, agent)",
          "legendFormat": "OpenCode",
          "refId": "B",
          "instant": true
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Error Sessions (24h)",
      "description": "OpenClaw runs that ended with outcome=error in the last 24 hours. Claude Code and OpenCode errors are in Loki logs.",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "timeFrom": "now-24h",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "short",
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_run_duration_ms_count{openclaw_outcome=\"error\",job=~\"$openclaw_enable\"}[24h])) without (openclaw_model, openclaw_provider, openclaw_channel, openclaw_agent)",
          "legendFormat": "OpenClaw errors",
          "refId": "A",
          "instant": true
        }
      ]
    },

    {
      "id": 6,
      "type": "row",
      "title": "Activity over time",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Sessions per hour by tool",
      "description": "Stacked session rate (1h increase) for all three tools over the selected range",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" },
            "drawStyle": "line",
            "gradientMode": "none"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(claude_code_session_count[$__interval]))",
          "legendFormat": "Claude Code",
          "interval": "1h",
          "refId": "A"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(opencode_session_count{is_subagent=\"false\"}[$__interval]))",
          "legendFormat": "OpenCode",
          "interval": "1h",
          "refId": "B"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_run_duration_ms_count{job=~\"$openclaw_enable\"}[$__interval])) without (openclaw_model, openclaw_provider, openclaw_outcome, openclaw_channel, openclaw_agent)",
          "legendFormat": "OpenClaw",
          "interval": "1h",
          "refId": "C"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(github_copilot_agent_turn_count_count{job=~\"$copilot_enable\"}[$__interval])) without (gen_ai_operation_name)",
          "legendFormat": "GitHub Copilot",
          "interval": "1h",
          "refId": "D"
        }
      ]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost per day by tool (USD)",
      "description": "Daily spend (1d increase) for Claude Code and OpenCode. OpenClaw has no cost metric.",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "drawStyle": "bars",
            "gradientMode": "none"
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(claude_code_cost_usage[$__interval])) without (session_id, user_email, user_id, user_account_id, user_account_uuid, organization_id, model, effort, query_source, terminal_type, agent_name, skill_name)",
          "legendFormat": "Claude Code",
          "interval": "1d",
          "refId": "A"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(opencode_cost_usage[$__interval])) without (session_id, project_id, model, agent)",
          "legendFormat": "OpenCode",
          "interval": "1d",
          "refId": "B"
        }
      ]
    },

    {
      "id": 18,
      "type": "timeseries",
      "title": "Token activity (1h buckets)",
      "description": "Tokens consumed per 1h window, stacked by tool. Shows which hours and days are most active. A true UTC-hour × day-of-week heatmap requires the Grafana Calendar plugin or Prometheus recording rules with hour/day_of_week labels.",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "stacking": { "mode": "normal", "group": "A" },
            "drawStyle": "bars",
            "gradientMode": "none",
            "barAlignment": 0
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(claude_code_token_usage[$__interval])) without (session_id, user_email, user_id, user_account_id, user_account_uuid, organization_id, type, effort, query_source, model, terminal_type, agent_name, skill_name)",
          "legendFormat": "Claude Code",
          "interval": "1h",
          "refId": "A"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(opencode_token_usage[$__interval])) without (session_id, project_id, type, agent, model)",
          "legendFormat": "OpenCode",
          "interval": "1h",
          "refId": "B"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_tokens{openclaw_token=\"total\",job=~\"$openclaw_enable\"}[$__interval])) without (openclaw_model, openclaw_provider, openclaw_agent, openclaw_channel, openclaw_token)",
          "legendFormat": "OpenClaw",
          "interval": "1h",
          "refId": "C"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(gen_ai_client_token_usage_sum{job=~\"$copilot_enable\"}[$__interval]))",
          "legendFormat": "GitHub Copilot",
          "interval": "1h",
          "refId": "D"
        }
      ]
    },

    {
      "id": 9,
      "type": "row",
      "title": "Session rhythm",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Session rhythm — all tools (1h resolution)",
      "description": "Session count across all tools by hour of day over 7 days. Use this to spot peak usage hours. Stack = all tools combined.",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": { "mode": "normal", "group": "A" },
            "drawStyle": "bars",
            "gradientMode": "none",
            "barAlignment": 0
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(claude_code_session_count[$__interval]))",
          "legendFormat": "Claude Code",
          "interval": "1h",
          "refId": "A"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "count(count_over_time(opencode_session_count{is_subagent=\"false\"}[$__interval]))",
          "legendFormat": "OpenCode",
          "interval": "1h",
          "refId": "B"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(openclaw_run_duration_ms_count{job=~\"$openclaw_enable\"}[$__interval])) without (openclaw_model, openclaw_provider, openclaw_outcome, openclaw_channel, openclaw_agent)",
          "legendFormat": "OpenClaw",
          "interval": "1h",
          "refId": "C"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum(increase(github_copilot_agent_turn_count_count{job=~\"$copilot_enable\"}[$__interval])) without (gen_ai_operation_name)",
          "legendFormat": "GitHub Copilot",
          "interval": "1h",
          "refId": "D"
        }
      ]
    },

    {
      "id": 11,
      "type": "row",
      "title": "Model usage",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },

    {
      "id": 12,
      "type": "piechart",
      "title": "Token share by model (7d)",
      "description": "Proportion of tokens consumed per model across Claude Code and OpenCode over the selected range",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 10, "x": 0, "y": 33 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "pie",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (increase(claude_code_token_usage[$__range]))",
          "legendFormat": "claude-code: {{model}}",
          "refId": "A",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (increase(opencode_token_usage[$__range]))",
          "legendFormat": "opencode: {{model}}",
          "refId": "B",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (openclaw_model) (increase(openclaw_tokens{job=~\"$openclaw_enable\"}[$__range]))",
          "legendFormat": "openclaw: {{openclaw_model}}",
          "refId": "C",
          "instant": true
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (gen_ai_request_model) (increase(gen_ai_client_token_usage_sum{job=~\"$copilot_enable\"}[$__range]))",
          "legendFormat": "copilot: {{gen_ai_request_model}}",
          "refId": "D",
          "instant": true
        }
      ]
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "Tokens per day by model",
      "description": "Daily token consumption stacked by model across all tools — tracks model drift over time",
      "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 14, "x": 10, "y": 33 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "drawStyle": "bars",
            "gradientMode": "none"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (increase(claude_code_token_usage[$__interval]))",
          "legendFormat": "claude-code: {{model}}",
          "interval": "1d",
          "refId": "A"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (model) (increase(opencode_token_usage[$__interval]))",
          "legendFormat": "opencode: {{model}}",
          "interval": "1d",
          "refId": "B"
        },
        {
          "datasource": { "type": "datasource", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (openclaw_model) (increase(openclaw_tokens{job=~\"$openclaw_enable\"}[$__interval]))",
